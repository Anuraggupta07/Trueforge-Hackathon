{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WardenReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:ListSnapshotsInRecycleBin",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:GetMetricData",
        "cloudtrail:LookupEvents",
        "rbin:ListRules",
        "rbin:GetRule",
        "route53:ListHostedZones",
        "route53:ListResourceRecordSets",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WardenBackupAndRestoreVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot",
        "ec2:CreateVolume"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:*::snapshot/*"
      ]
    },
    {
      "Sid": "WardenTagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:*::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "CreateSnapshot",
            "CreateVolume"
          ]
        }
      }
    },
    {
      "Sid": "WardenOwnTagsOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:*::snapshot/*",
        "arn:aws:ec2:*:*:instance/*",
        "arn:aws:ec2:*:*:elastic-ip/*"
      ],
      "Condition": {
        "ForAllValues:StringLike": {
          "aws:TagKeys": [
            "warden:*"
          ]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    },
    {
      "Sid": "WardenDeleteVolumes",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:*:*:volume/*"
    },
    {
      "Sid": "WardenSnapshotsAndRecycleBin",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSnapshot",
        "ec2:RestoreSnapshotFromRecycleBin"
      ],
      "Resource": [
        "arn:aws:ec2:*::snapshot/*"
      ]
    },
    {
      "Sid": "WardenStopStartInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances",
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*"
    },
    {
      "Sid": "WardenReleaseElasticIps",
      "Effect": "Allow",
      "Action": "ec2:ReleaseAddress",
      "Resource": "arn:aws:ec2:*:*:elastic-ip/*"
    },
    {
      "Sid": "WardenKmsGrantOnlyForEbs",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ec2.*.amazonaws.com"
        },
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "WardenKmsUseOnlyThroughEbs",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncrypt*"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ec2.*.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyTerminateAlways",
      "Effect": "Deny",
      "Action": "ec2:TerminateInstances",
      "Resource": "*"
    },
    {
      "Sid": "DenyProtectTagWrites",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEqualsIgnoreCase": {
          "aws:TagKeys": [
            "warden:protect"
          ]
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnProdByEnvTag",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/env": [
            "prod*",
            "Prod*",
            "PROD*",
            "prd*",
            "Prd*",
            "PRD*"
          ]
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnProdByEnvironmentTag",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/environment": [
            "prod*",
            "Prod*",
            "PROD*",
            "prd*",
            "Prd*",
            "PRD*"
          ]
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnProdByStageTag",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/stage": [
            "prod*",
            "Prod*",
            "PROD*",
            "prd*",
            "Prd*",
            "PRD*"
          ]
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnLegalHold",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/legal-hold": "false"
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnLegalHoldUnderscore",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/legal_hold": "false"
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnLegalHoldNoSeparator",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/legalhold": "false"
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnDrTag",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/dr": "false"
        },
        "StringNotEqualsIgnoreCase": {
          "aws:ResourceTag/dr": [
            "false",
            "no",
            "0"
          ]
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnDrRole",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "aws:ResourceTag/role": "dr"
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnWardenProtect",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "aws:ResourceTag/warden:protect": "true"
        }
      }
    }
  ]
}
