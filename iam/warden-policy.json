{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WardenReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:ListSnapshotsInRecycleBin",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:GetMetricData",
        "cloudtrail:LookupEvents",
        "rbin:ListRules",
        "rbin:GetRule",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WardenBackupAndRestoreVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot",
        "ec2:CreateVolume"
      ],
      "Resource": [
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:*::snapshot/*"
      ]
    },
    {
      "Sid": "WardenTagOnlyVolumesSnapshotsInstances",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:*:*:volume/*",
        "arn:aws:ec2:*::snapshot/*",
        "arn:aws:ec2:*:*:instance/*"
      ]
    },
    {
      "Sid": "WardenDeleteVolumes",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:*:*:volume/*"
    },
    {
      "Sid": "WardenSnapshotsAndRecycleBin",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSnapshot",
        "ec2:RestoreSnapshotFromRecycleBin"
      ],
      "Resource": [
        "arn:aws:ec2:*::snapshot/*"
      ]
    },
    {
      "Sid": "WardenStopStartInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances",
        "ec2:StartInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*"
    },
    {
      "Sid": "WardenReleaseElasticIps",
      "Effect": "Allow",
      "Action": "ec2:ReleaseAddress",
      "Resource": "arn:aws:ec2:*:*:elastic-ip/*"
    },
    {
      "Sid": "DenyTerminateAlways",
      "Effect": "Deny",
      "Action": "ec2:TerminateInstances",
      "Resource": "*"
    },
    {
      "Sid": "DenyDestructiveOnProdByEnvTag",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "aws:ResourceTag/env": ["production", "prod", "Production", "PROD"]
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnProdByEnvironmentTag",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "aws:ResourceTag/environment": ["production", "prod", "Production", "PROD"]
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnLegalHold",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/legal-hold": "false"
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnLegalHoldUnderscore",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/legal_hold": "false"
        }
      }
    },
    {
      "Sid": "DenyDestructiveOnWardenProtect",
      "Effect": "Deny",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:StopInstances",
        "ec2:ReleaseAddress"
      ],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "aws:ResourceTag/warden:protect": "true"
        }
      }
    }
  ]
}
