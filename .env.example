# Warden configuration. Copy to .env and adjust. NEVER put AWS keys in this file.
#
# AWS credentials come from the standard AWS chain: `aws configure` (~/.aws/credentials),
# an AWS_PROFILE, SSO, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY exported in your shell.
# They are never committed. Use a least-privilege identity with iam/warden-policy.json.

# --- AWS ---------------------------------------------------------------------
# Region Warden scans and acts in (one region per run). Falls back to AWS_DEFAULT_REGION.
AWS_REGION=us-east-1

# --- Safety ------------------------------------------------------------------
# Only resources carrying this tag (key=value) are cleanup TARGETS. Leave empty to
# target everything in the region (not recommended for demos).
WARDEN_SCOPE_TAG=warden:demo=true
# Emergency brake: true makes every mutating tool refuse (e.g. during change freezes).
WARDEN_FREEZE=false
# Max resource ids per reversible action call (clamped to 1..20). Irreversible = always 1.
WARDEN_MAX_BATCH=5
# How long a scan's plan stays valid for actions, in minutes.
WARDEN_PLAN_TTL_MINUTES=60

# --- Idle-instance detection -------------------------------------------------
# CloudWatch lookback window in minutes. 30 is a demo value; use 43200 (30 days) for real use.
WARDEN_IDLE_LOOKBACK_MINUTES=30
# Instance is idle if max CPU% stays below this...
WARDEN_IDLE_CPU_PCT=5.0
# ...and NetworkIn+NetworkOut per hour stays below this many bytes.
WARDEN_IDLE_NETWORK_BYTES_PER_HOUR=5000000

# --- Backups and evidence ----------------------------------------------------
# Warden backup snapshots expire (and become cleanup candidates) after this many days.
WARDEN_BACKUP_RETENTION_DAYS=7
# Max number of targets per scan to look up the creator for in CloudTrail.
WARDEN_OWNER_LOOKUP_LIMIT=25
# How long to wait for a backup snapshot to complete before keeping the volume instead.
WARDEN_SNAPSHOT_WAIT_SECONDS=600
# Where plans, receipts and the audit log are stored (default: <repo>/.warden).
# WARDEN_STATE_DIR=

# --- MCP server --------------------------------------------------------------
WARDEN_HOST=127.0.0.1
WARDEN_PORT=8000
# URL TrueForge uses to reach the Warden MCP server.
WARDEN_MCP_URL=http://127.0.0.1:8000/mcp

# --- TrueForge ---------------------------------------------------------------
TRUEFORGE_BASE_URL=http://localhost:8790
# Model id configured in your TrueForge instance (fill in; no default).
TRUEFORGE_MODEL=
